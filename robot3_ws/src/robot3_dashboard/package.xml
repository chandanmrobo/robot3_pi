<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
             schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot3_dashboard</name>
  <version>0.0.1</version>
  <description>Dashboard storage + analytics backend for Robot 3</description>

  <maintainer email="chandan.m.reddy21@gmail.com">chandan</maintainer>
  <license>Apache-2.0</license>


  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ROS2 Python Client Library -->
  <exec_depend>rclpy</exec_depend>

  <!-- Robot3 internal message types -->
  <exec_depend>robot3_msgs</exec_depend>

  <!-- Launch system -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Flask for /api/dashboard -->
  <exec_depend>python3-flask</exec_depend>

  <!-- General Python dependencies (json, datetime are builtin) -->
  <exec_depend>python3</exec_depend>

  <!-- TEST DEPENDENCIES                                         -->
 
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
